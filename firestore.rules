rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }
    
    function isAdmin() {
      let data = getUserData();
      return data != null && data.get('role', '').lower() in ['admin', 'super_admin'];
    }
    
    function isVendor() {
      let data = getUserData();
      return data != null && (
        data.get('role', '').lower() == 'vendor' || 
        data.get('vendorStatus', null) != null
      );
    }
    
    function isStaff() {
      let data = getUserData();
      let role = data.get('role', '').lower();
      return data != null && 
             data.get('workshopId', null) != null &&
             !(role in ['customer', 'vendor']);
    }

    function isSuperAdmin() {
      let data = getUserData();
      return data != null && data.get('role', '').lower() == 'super_admin';
    }
    
    function getUserWorkshopId() {
      let data = getUserData();
      return data != null ? data.get('workshopId', null) : null;
    }
    
    match /users/{userId} {
      // DEBUG: Allowing full public read to resolve permission errors during onboarding
      allow read, list: if true;
      
      // Allow read/write for owner
      allow write: if isAuthenticated() && request.auth.uid == userId;
      
      // Admin bypass
      allow write: if isSuperAdmin();
    }
    
    match /workshops/{workshopId} {
      allow get, list: if true; // Public read needed for signup/workshop selection
      allow create: if isAuthenticated() && (request.auth.uid == workshopId || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == workshopId || (isAdmin() && getUserWorkshopId() == workshopId) || isSuperAdmin());
      
      match /settings/permissions {
        allow read: if isAuthenticated();
        allow write: if (isAdmin() && getUserWorkshopId() == workshopId) || isSuperAdmin();
      }
    }
    
    // Customer registrations must be readable during signup (before auth),
    // so reads are open, but writes are still restricted to staff/bootstrap.
    match /customerRegistrations/{registrationId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId()) || 
        request.resource.data.workshopId == request.auth.uid
      );
      allow update: if isAuthenticated() && ( 
        isSuperAdmin() ||
        (isStaff() && resource.data.workshopId == getUserWorkshopId()) || 
        (request.resource.data.used == true) 
      );
    }
    
    // Staff invitations must be readable during invite acceptance (before auth),
    // so reads are open, but writes remain restricted to staff/bootstrap.
    match /staffInvitations/{invitationId} {
      allow read: if true; // Public read for invite code validation
      
      // Separate Super Admin rule for clarity and priority
      allow create: if isSuperAdmin();
      
      // Standard Staff/User rule
      allow create: if isAuthenticated() && (
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId()) || 
        request.resource.data.workshopId == request.auth.uid
      );
      
      allow update: if isAuthenticated() && ( 
        isSuperAdmin() ||
        (isStaff() && resource.data.workshopId == getUserWorkshopId()) || 
        (request.resource.data.used == true) 
      );
    }
    
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email)
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email)
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email)
      );
    }
    
    match /jobs/{jobId} {
      allow read: if resource == null || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow read: if resource != null && (
        isSuperAdmin() ||
        (isStaff() && resource.data.workshopId == getUserWorkshopId()) ||
        (resource.data.get('assignedTechnicianId', '') == request.auth.uid) ||
        (request.auth.uid in resource.data.get('assignedTechnicianIds', []))
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid ||
          (isStaff() && get(/databases/$(database)/documents/jobs/$(jobId)).data.workshopId == getUserWorkshopId())
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid ||
          (isStaff() && get(/databases/$(database)/documents/jobs/$(jobId)).data.workshopId == getUserWorkshopId())
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid ||
          (isStaff() && get(/databases/$(database)/documents/jobs/$(jobId)).data.workshopId == getUserWorkshopId())
        );
      }
    }
    
    match /invoices/{invoiceId} {
      // Customer reads own invoices by userId
      allow read: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
      // Customer reads invoices linked by email
      allow read: if isAuthenticated() && resource != null && resource.data.customerEmail != null && getUserData() != null && resource.data.customerEmail == getUserData().email;
      // Non-existent doc check (for get() calls)
      allow read: if resource == null && isAuthenticated();
      // Staff/admin reads
      allow read: if resource != null && (
        isSuperAdmin() || 
        (isStaff() && resource.data.workshopId == getUserWorkshopId())
      );
      allow create: if isSuperAdmin() || 
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId()) || 
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      
      allow update: if isSuperAdmin() || 
        (isStaff() && (resource.data.workshopId == getUserWorkshopId() || resource.data.workshopId == null)) ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.customerEmail != null && getUserData() != null && resource.data.customerEmail == getUserData().email);
    }
 
    match /quotes/{quoteId} {
      // Customer reads by customerId
      allow read: if isAuthenticated() && resource != null && resource.data.customerId == request.auth.uid;
      // Customer reads by userId
      allow read: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
      // Customer reads by email
      allow read: if isAuthenticated() && resource != null && resource.data.customerEmail != null && getUserData() != null && resource.data.customerEmail == getUserData().email;
      // Non-existent doc check
      allow read: if resource == null && isAuthenticated();
      // Staff/admin reads
      allow read: if resource != null && (
        isSuperAdmin() || 
        (isStaff() && resource.data.workshopId == getUserWorkshopId())
      );
      allow create: if isSuperAdmin() || 
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId());
      
      // Allow customers to update quotes (for approval)
      allow update: if isSuperAdmin() || 
        (isStaff() && resource.data.workshopId == getUserWorkshopId()) ||
        (isAuthenticated() && resource.data.customerId == request.auth.uid) ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.customerEmail != null && getUserData() != null && resource.data.customerEmail == getUserData().email);
    }
    
    match /inventory/{itemId} {
      allow read: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.workshopId == getUserWorkshopId());
      allow update: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
      allow delete: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
    }
    
    match /stockTransactions/{transactionId} {
      allow read: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.workshopId == getUserWorkshopId());
    }
    
    match /marketplaceProducts/{productId} {
      // Allow public read for approved products (supports guest browsing)
      // Authenticated users (vendors/staff) can see all products including unapproved
      allow read: if resource.data.approved == true || isAuthenticated();
      allow create: if isAuthenticated() && (isStaff() || isVendor());
      allow update: if isAuthenticated() && (isStaff() || (isVendor() && resource.data.vendorId == request.auth.uid));
    }
    
    match /orders/{orderId} {
      // Guest checkout support: orders are publicly readable/writable
      // Guests place orders with their email, then can view them via email lookup
      // Security note: Consider restricting updates to order owner in future
      allow read: if true; 
      allow create: if true;
      allow update: if true;
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if true; // Allow guests to trigger notifications
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
    }

    match /notification_tokens/{userId} {
      // Allow any authenticated user to read tokens (needed for customers to notify admins)
      // Ideally we'd restrict this to only reading tokens of staff/admins, but
      // for now we trust the client to only query for admins.
      allow read: if isAuthenticated();
      
      // Only the user themselves can write their own token
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
