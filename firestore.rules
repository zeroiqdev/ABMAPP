rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function getUserData() {
      return userExists() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData() != null && (getUserData().role == 'admin' || getUserData().role == 'super_admin');
    }
    
    function isStaff() {
      return isAuthenticated() && getUserData() != null && (getUserData().role == 'admin' || getUserData().role == 'super_admin' || getUserData().role == 'service_advisor' || getUserData().role == 'technician' || getUserData().role == 'storekeeper' || getUserData().role == 'accountant');
    }
    
    function isVendor() {
      return isAuthenticated() && getUserData() != null && getUserData().role == 'vendor';
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData() != null && getUserData().role == 'super_admin';
    }
    
    function getUserWorkshopId() {
      let userData = getUserData();
      return (userData != null && userData.keys().hasAny(['workshopId'])) ? userData.workshopId : null;
    }
    
    match /users/{userId} {
      // Allow read if:
      // 1. Reading own document (by UID)
      // 2. Staff reading users in their workshop
      // 3. User reading a document where email matches their auth email (for signup migration)
      // 4. Super Admin
      allow read: if resource == null || (isAuthenticated() && request.auth.uid == userId);
      allow read: if resource != null && isStaff() && getUserWorkshopId() == resource.data.workshopId;
      allow read: if resource != null && isAuthenticated() && resource.data.email != null && resource.data.email == request.auth.token.email;
      allow read: if isSuperAdmin(); // Super Admin Access

      allow create: if isAuthenticated() && (request.auth.uid == userId || isStaff() || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isStaff() || isSuperAdmin());
      // Allow delete if user is deleting their own pre-created document during signup migration or Super Admin
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId || 
        isStaff() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email) ||
        isSuperAdmin()
      );
    }
    
    match /workshops/{workshopId} {
      allow read: if isAuthenticated(); // Maybe restricted later, but currently wide for signup check
      allow create: if isAuthenticated() && (request.auth.uid == workshopId || isSuperAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == workshopId || (isAdmin() && getUserWorkshopId() == workshopId) || isSuperAdmin());
      
      match /settings/permissions {
        allow read: if isAuthenticated();
        allow write: if (isAdmin() && getUserWorkshopId() == workshopId) || isSuperAdmin();
      }
    }
    
    // Customer registrations must be readable during signup (before auth),
    // so reads are open, but writes are still restricted to staff/bootstrap.
    match /customerRegistrations/{registrationId} {
      allow read: if true;
      allow create: if isAuthenticated() && (
        isSuperAdmin() || 
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId()) || 
        request.resource.data.workshopId == request.auth.uid
      );
      allow update: if isAuthenticated() && ( 
        isSuperAdmin() ||
        (isStaff() && resource.data.workshopId == getUserWorkshopId()) || 
        (request.resource.data.used == true) 
      );
    }
    
    // Staff invitations must be readable during invite acceptance (before auth),
    // so reads are open, but writes remain restricted to staff/bootstrap.
    match /staffInvitations/{invitationId} {
      allow read: if true; // Public read for invite code validation
      
      // Separate Super Admin rule for clarity and priority
      allow create: if isSuperAdmin();
      
      // Standard Staff/User rule
      allow create: if isAuthenticated() && (
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId()) || 
        request.resource.data.workshopId == request.auth.uid
      );
      
      allow update: if isAuthenticated() && ( 
        isSuperAdmin() ||
        (isStaff() && resource.data.workshopId == getUserWorkshopId()) || 
        (request.resource.data.used == true) 
      );
    }
    
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email)
      );
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email)
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isStaff() ||
        (get(/databases/$(database)/documents/users/$(resource.data.userId)).data.email == request.auth.token.email)
      );
    }
    
    match /jobs/{jobId} {
      allow read: if resource == null || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow read: if resource != null && isStaff() && resource.data.workshopId == getUserWorkshopId();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isStaff());
      allow update: if isStaff() && resource.data.workshopId == getUserWorkshopId();

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid ||
          (isStaff() && get(/databases/$(database)/documents/jobs/$(jobId)).data.workshopId == getUserWorkshopId())
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid ||
          (isStaff() && get(/databases/$(database)/documents/jobs/$(jobId)).data.workshopId == getUserWorkshopId())
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/jobs/$(jobId)).data.userId == request.auth.uid ||
          (isStaff() && get(/databases/$(database)/documents/jobs/$(jobId)).data.workshopId == getUserWorkshopId())
        );
      }
    }
    
    match /invoices/{invoiceId} {
      allow read: if resource == null || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow read: if resource != null && (
        isSuperAdmin() || 
        (isStaff() && resource.data.workshopId == getUserWorkshopId())
      );
      allow create: if isSuperAdmin() || 
        (isStaff() && request.resource.data.workshopId == getUserWorkshopId()) || 
        (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      
      allow update: if isSuperAdmin() || 
        (isStaff() && resource.data.workshopId == getUserWorkshopId());
    }
    
    match /inventory/{itemId} {
      allow read: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.workshopId == getUserWorkshopId());
      allow update: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
      allow delete: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
    }
    
    match /stockTransactions/{transactionId} {
      allow read: if isSuperAdmin() || (isStaff() && resource.data.workshopId == getUserWorkshopId());
      allow create: if isSuperAdmin() || (isStaff() && request.resource.data.workshopId == getUserWorkshopId());
    }
    
    match /marketplaceProducts/{productId} {
      allow read: if (resource.data.approved == true) || isAuthenticated();
      allow create: if isAuthenticated() && (isStaff() || getUserData().role == 'vendor');
      allow update: if isAuthenticated() && (isStaff() || (getUserData().role == 'vendor' && resource.data.vendorId == request.auth.uid));
    }
    
    match /orders/{orderId} {
      // Allow read for queries - any authenticated user can query
      // The query itself (where('vendorIds', 'array-contains', vendorId)) filters results
      // Relaxed for Guest Access (Insecure: Allows public reading of orders with email)
      allow read: if true; 
      allow create: if true;
      allow update: if true;
    }
    
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
      allow create: if true; // Allow guests to trigger notifications
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isStaff());
    }

    match /config/{document} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
