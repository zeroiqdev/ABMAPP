require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

platform :ios, '15.1'
prepare_react_native_project!

target 'ABMWorkshopMarketplace' do
  use_expo_modules!
  
  config = use_native_modules!
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    # This section fixes BOTH issues
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Fix 1: Disable warnings as errors (prevents fastlane build failures)
        config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        
        # Fix 2: Enable modular headers for Firebase (fixes CocoaPods error)
        if ['FirebaseCore', 'FirebaseInstallations', 'FirebaseCoreExtension',
            'GoogleDataTransport', 'GoogleUtilities', 'nanopb'].include? target.name
          config.build_settings['DEFINES_MODULE'] = 'YES'
        end
        
        # Fix 3: Allow non-modular includes for RNFB (prevents header errors)
        if target.name.start_with?('RNFB')
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        end
        
        # Fix 4: Set deployment target consistently
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
      end
    end
    
    # Fix 5: Ensure proper build settings for all targets
    installer.pods_project.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end
end
